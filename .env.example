# PostgreSQL Bağlantısı (Lokal PostgreSQL 17 bilgilerinizi buraya girin)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otobeyin?schema=public"

# Oturum & Güvenlik (Production ortamında en az 32 karakter rastgele değer kullanın)
JWT_SECRET="otobeyinpazari-local-dev-secret-key-2026-change-in-prod"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opsiyonel Harici Adaptörler (Boş bırakılırsa Sandbox / DB Log modunda çalışır)
SMS_PROVIDER="sandbox"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
PAYMENT_PROVIDER="sandbox"
CARGO_PROVIDER="sandbox"
EINVOICE_PROVIDER="sandbox"
